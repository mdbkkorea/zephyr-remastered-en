<Window x:Class="ZephyrPatcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/patcher.ico" Title="西风狂诗曲 · 中文补丁" Width="820" Height="630" MinWidth="720" MinHeight="590" Background="#F4F0E7" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#E9E2D4"/><Setter Property="Foreground" Value="#38372E"/><Setter Property="BorderBrush" Value="#CFC6B5"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#38372E"/></Style>
 </Window.Resources>
 <Grid Margin="36,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="西风狂诗曲" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="重制版 · 非官方简体中文补丁" Margin="0,7,0,0" Foreground="#6A675B"/><TextBlock Text="为爱发电，让记忆里的冒险再次启程。" Margin="0,10,0,24" Foreground="#777265"/></StackPanel>
  <StackPanel Grid.Row="1"><TextBlock Text="游戏位置" FontWeight="SemiBold" Margin="0,0,0,8"/><DockPanel><Button Content="选择文件夹" DockPanel.Dock="Right" Click="BrowseClick" Margin="12,0,0,0"/><TextBox x:Name="GamePath" Padding="10" VerticalContentAlignment="Center" Background="#FFFCF6" BorderBrush="#CFC6B5" TextChanged="PathChanged"/></DockPanel></StackPanel>
  <Border Grid.Row="2" Background="#E9EDE3" BorderBrush="#CFD6C6" BorderThickness="1" Padding="18" Margin="0,22,0,22"><StackPanel><TextBlock x:Name="StateTitle" Text="选择游戏目录后，即可开始" FontSize="18" FontWeight="SemiBold" Foreground="#354E3A"/><TextBlock x:Name="StateDetail" Text="仅支持 Steam 重制版；不会修改存档。" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
  <StackPanel Grid.Row="3"><WrapPanel><Button x:Name="InstallButton" Content="安装汉化" Background="#36533D" Foreground="White" BorderBrush="#36533D" FontSize="17" Padding="28,13" IsEnabled="False" Click="InstallClick"/><Button x:Name="RestoreButton" Content="恢复原版" FontSize="17" Padding="28,13" IsEnabled="False" Click="RestoreClick"/><Button x:Name="RecoverButton" Content="恢复上次操作" Visibility="Collapsed" Click="RecoverClick"/></WrapPanel><ProgressBar x:Name="Progress" Height="5" Margin="0,18,0,10" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="ProgressText" Text="安装前自动备份 · 保留原版美术字 · 使用朱雀仿宋" Foreground="#706B5E" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
  <StackPanel Grid.Row="4"><Separator Background="#D8D0C1" Margin="0,10,0,16"/><WrapPanel><Button Content="检查更新" Click="CheckUpdateClick"/><Button Content="问题反馈" Click="FeedbackClick"/><Button Content="支持正版" Click="StoreClick"/></WrapPanel><DockPanel Margin="0,14,0,0"><TextBlock Text="v0.1.0 · 免费、开源、非官方" FontSize="12" Foreground="#827B6E"/><TextBlock x:Name="UpdateStatus" Text="" FontSize="12" Foreground="#827B6E" HorizontalAlignment="Right"/></DockPanel></StackPanel>
 </Grid>
</Window>
