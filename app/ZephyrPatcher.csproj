<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZephyrChinesePatcher</AssemblyName><Version>0.1.0</Version><FileVersion>0.1.0.5</FileVersion>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages><DebugType>embedded</DebugType><ApplicationIcon>Assets/patcher.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/patcher.ico" /></ItemGroup></Project>
