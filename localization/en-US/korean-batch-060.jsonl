{"id": "1eb96a68e860ebd98371a864c33d9864a674dfc2b5b9f913d226b3e2581ce147", "original": "아는 사람입니까?", "contains_korean": true, "chinese_reference": "你认识他？", "object_name": "art_ko_flcni08", "reference": {"file": "ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle", "serialized_file": "CAB-c86448dee009bfdefa236923310b57ad", "object_id": -1342836043309279069, "path": ["TextList", 29, "Text"]}, "patch_json_path": ["files", 8, "changes", 143, "ops", 26, "value"], "target": "Do you know him?", "status": "draft", "translation_basis": "original Korean", "notes": ["Exact Korean reuse; Korean and Chinese context checked for this occurrence."]}
