{"id": "d3a007ae8166450415a5528f1d05ecdae371354e34c2d3fe55270e034608036a", "original": "동굴이…", "contains_korean": true, "chinese_reference": "洞穴……", "object_name": "art_fl02_tem", "reference": {"file": "ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle", "serialized_file": "CAB-47185da1467218b32cbdb884ad62424c", "object_id": -2051611229472442388, "path": ["TextList", 6, "Text"]}, "patch_json_path": ["files", 9, "changes", 124, "ops", 5, "value"], "target": "The cave...", "status": "draft", "translation_basis": "original Korean", "notes": ["Korean authoritative; Chinese checked as supporting context. Trisis and Storm Island remain provisional place names."]}
{"id": "b106c6d0f370c9866e042c5f70dfee9e753c342559a3bac58fa34a90b86b8ff9", "original": "동굴이 무너진다!!!", "contains_korean": true, "chinese_reference": "洞穴要塌了！！！", "object_name": "art_fl02_tem", "reference": {"file": "ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle", "serialized_file": "CAB-47185da1467218b32cbdb884ad62424c", "object_id": -2051611229472442388, "path": ["TextList", 7, "Text"]}, "patch_json_path": ["files", 9, "changes", 124, "ops", 6, "value"], "target": "The cave is collapsing!!!", "status": "draft", "translation_basis": "original Korean", "notes": ["Korean authoritative; Chinese checked as supporting context. Trisis and Storm Island remain provisional place names."]}
{"id": "d77f202af531e96a71e36978682769c6a95256c5239e444c420b63e8e184cd64", "original": "뭐라고!!!", "contains_korean": true, "chinese_reference": "什么！！！", "object_name": "art_fl02_tem", "reference": {"file": "ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle", "serialized_file": "CAB-47185da1467218b32cbdb884ad62424c", "object_id": -2051611229472442388, "path": ["TextList", 8, "Text"]}, "patch_json_path": ["files", 9, "changes", 124, "ops", 7, "value"], "target": "What!!!", "status": "draft", "translation_basis": "original Korean", "notes": ["Korean authoritative; Chinese checked as supporting context. Trisis and Storm Island remain provisional place names."]}
