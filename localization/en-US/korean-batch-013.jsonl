{"id": "8ebca2dc4b2993415eeda7233c84d7d4f08282baac8bd867b800950c4bbfc8fc", "original": "큰일이다!", "contains_korean": true, "chinese_reference": "不好了！", "object_name": "art_ko_fl02_tem", "reference": {"file": "ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle", "serialized_file": "CAB-c86448dee009bfdefa236923310b57ad", "object_id": -4947622940401403110, "path": ["TextList", 5, "Text"]}, "patch_json_path": ["files", 8, "changes", 68, "ops", 4, "value"], "target": "We're in trouble!", "status": "draft", "translation_basis": "original Korean", "notes": ["Korean authoritative; Chinese checked as supporting context. Trisis and Storm Island remain provisional place names."]}
{"id": "4d4e50937f705b640d8b5acbcbe5a9e549c4d1be3f3cf8fbaafb20245b1f7728", "original": "동굴이...", "contains_korean": true, "chinese_reference": "洞穴……", "object_name": "art_ko_fl02_tem", "reference": {"file": "ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle", "serialized_file": "CAB-c86448dee009bfdefa236923310b57ad", "object_id": -4947622940401403110, "path": ["TextList", 6, "Text"]}, "patch_json_path": ["files", 8, "changes", 68, "ops", 5, "value"], "target": "The cave...", "status": "draft", "translation_basis": "original Korean", "notes": ["Korean authoritative; Chinese checked as supporting context. Trisis and Storm Island remain provisional place names."]}
